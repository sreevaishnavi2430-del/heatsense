# Local environment and secrets
#
# VITE_* values are bundled into the client build and are therefore public, but
# the Google Maps browser key is still kept local and restricted by HTTP referrer.
# .env.production holds only VITE_ variables and is tracked so the deployment
# build configuration lives in the repository.
.env
.env.*
!.env.example
!.env.development.example
!.env.production
backend/.env
backend/.env.*
!backend/.env.example

# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Python environments, caches and test artifacts
backend/.venv/
backend/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases and SQLite sidecars
*.db
*.sqlite
*.sqlite3
*-shm
*-wal

# Local logs
*.log

# The trained air-temperature model is a project artifact and is tracked, so the
# app has a usable model without retraining. Scratch files beside it are not.
model_artifacts/*
!model_artifacts/air_temp_model.joblib

# Editor and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
zip.zip

# Local project backup archives. These bundle the whole tree (including the
# un-ignored .env files and the virtualenv) and exceed GitHub's 100 MB limit.
frontend
*.zip
