# App runtime configuration
MODE=demo
DEMO_ANY_LOGIN=true

# Database storage URL
# For local development with zero dependencies:
DATABASE_URL=sqlite+aiosqlite:///./heatsense.db
# For Docker / PostgreSQL 15 + PostGIS 3:
# DATABASE_URL=postgresql+asyncpg://heatsense:heatsense_password@localhost:5432/heatsense

SECRET_KEY=replace-with-a-long-random-secret
FERNET_KEY=0w_3Nqk916qK2d8B1H0rX12_aG84kQZ7Wn-UqE6M2tM=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCHEDULER_ENABLED=false
DRY_RUN=true

# Optional Earth Engine credentials for live satellite ingestion
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=
GEE_PROJECT=

# Optional Twilio credentials for SMS / WhatsApp dispatch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
