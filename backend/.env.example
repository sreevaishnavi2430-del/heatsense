# App runtime configuration
#
# MODE=demo disables authentication on the protected endpoints and accepts any
# credentials. It is for local development and demos only.
# For any deployment, set MODE=production and provide unique secrets below:
#
#   MODE=production
#   SECRET_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(48))")
#   FERNET_KEY=$(python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
#
# The service refuses to start with MODE=production while either secret is still
# the placeholder value below.
MODE=demo
DEMO_ANY_LOGIN=true

# Database storage URL
# For local development with zero dependencies:
DATABASE_URL=sqlite+aiosqlite:///./heatsense.db
# For Docker / PostgreSQL 15 + PostGIS 3:
# DATABASE_URL=postgresql+asyncpg://heatsense:heatsense_password@localhost:5432/heatsense

# Replace both of these before deploying. The values below are published in this
# repository and must never be reused.
SECRET_KEY=replace-with-a-long-random-secret
FERNET_KEY=replace-with-a-fernet-generated-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCHEDULER_ENABLED=false
DRY_RUN=true

# Optional Earth Engine credentials for live satellite ingestion
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=
GEE_PROJECT=

# Optional Twilio credentials for SMS / WhatsApp dispatch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
