# The frontend ships with the full 40-ward dataset bundled, so mock mode is the
# default and the app runs without the FastAPI backend. Leave VITE_USE_MOCK unset
# (or set it to true) to use the bundled data.
VITE_USE_MOCK=true

# Set VITE_USE_MOCK=false to switch the app over to the live FastAPI backend.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: if blank, interactive ward maps use the OpenStreetMap fallback.
VITE_GOOGLE_MAPS_API_KEY=
